generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String
  name                String
  roleId              String    @db.Uuid
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  defaultForCompanies Company[] @relation("CompanyDefaultDriver")
  assignedDrops       Drop[]    @relation("DropDriver")
  role                Role      @relation(fields: [roleId], references: [id])

  @@index([roleId])
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Company {
  id                  String                      @id @default(uuid()) @db.Uuid
  name                String
  active              Boolean                     @default(true)
  ownerEmployeeId     String?                     @db.Uuid
  billingContactName  String?
  billingContactEmail String?
  billingContactPhone String?
  priceTierId         String?                     @db.Uuid
  defaultDeliveryTime String?
  deliveryLeadMinutes Int                         @default(60)
  defaultPackaging    String?
  driverInstructions  String?
  defaultDriverId     String?                     @db.Uuid
  mondayEnabled       Boolean                     @default(true)
  tuesdayEnabled      Boolean                     @default(true)
  wednesdayEnabled    Boolean                     @default(true)
  thursdayEnabled     Boolean                     @default(true)
  fridayEnabled       Boolean                     @default(true)
  saturdayEnabled     Boolean                     @default(false)
  sundayEnabled       Boolean                     @default(false)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  defaultDriver       User?                       @relation("CompanyDefaultDriver", fields: [defaultDriverId], references: [id])
  owner               Employee?                   @relation("CompanyOwner", fields: [ownerEmployeeId], references: [id])
  priceTier           PricingTier?                @relation(fields: [priceTierId], references: [id], onDelete: Restrict)
  addresses           CompanyAddress[]
  categoryVisibility  CompanyCategoryVisibility[]
  dishVisibility      CompanyDishVisibility[]
  emailDomains        CompanyEmailDomain[]
  holidays            CompanyHoliday[]
  drops               Drop[]
  employees           Employee[]
  invoices            Invoice[]
  orders              Order[]

  @@index([priceTierId])
  @@index([defaultDriverId])
  @@index([ownerEmployeeId])
}

model CompanyEmailDomain {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  domain    String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, domain])
  @@index([domain])
}

model CompanyAddress {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drops      Drop[]   @relation("DropAddress")
  orders     Order[]  @relation("OrderDeliveryAddress")

  @@index([companyId])
}

model Employee {
  id                    String                      @id @default(uuid()) @db.Uuid
  companyId             String                      @db.Uuid
  name                  String
  email                 String
  phone                 String?
  active                Boolean                     @default(true)
  canChooseAddress      Boolean                     @default(false)
  canChangeDeliveryTime Boolean                     @default(false)
  canChangePackaging    Boolean                     @default(false)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  ownedCompanies        Company[]                   @relation("CompanyOwner")
  company               Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allergies             EmployeeAllergy[]
  dietaryPreferences    EmployeeDietaryPreference[]
  orders                Order[]

  @@unique([companyId, email])
  @@index([companyId])
}

model EmployeeAllergy {
  employeeId String   @db.Uuid
  allergenId String   @db.Uuid
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, allergenId])
  @@index([allergenId])
}

model EmployeeDietaryPreference {
  employeeId   String     @db.Uuid
  dietaryTagId String     @db.Uuid
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, dietaryTagId])
  @@index([dietaryTagId])
}

model Dish {
  id                   String                  @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  imageUrl             String?
  sku                  String                  @unique
  temperature          Temperature
  costPrice            Decimal                 @db.Decimal(10, 2)
  stationId            String                  @db.Uuid
  minimumOrderQuantity Int                     @default(1)
  active               Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  categories           CategoryDish[]
  companyVisibility    CompanyDishVisibility[]
  station              Station                 @relation(fields: [stationId], references: [id])
  allergens            DishAllergen[]
  dietaryTags          DishDietaryTag[]
  prices               DishPrice[]
  optionGroups         OptionGroup[]
  orderLines           OrderLine[]

  @@index([active])
  @@index([stationId])
}

model Allergen {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @unique
  dishAllergens   DishAllergen[]
  employees       EmployeeAllergy[]
  optionAllergens OptionAllergen[]
}

model DietaryTag {
  id                String                      @id @default(uuid()) @db.Uuid
  name              String                      @unique
  dishDietaryTags   DishDietaryTag[]
  employees         EmployeeDietaryPreference[]
  optionDietaryTags OptionDietaryTag[]
}

model Station {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @unique
  active    Boolean           @default(true)
  dishes    Dish[]
  prepUnits KitchenPrepUnit[]
}

model Option {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String
  description  String?
  costPrice    Decimal                  @db.Decimal(10, 2)
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  allergens    OptionAllergen[]
  dietaryTags  OptionDietaryTag[]
  groups       OptionGroupOption[]
  sizePrices   OptionGroupOptionSize[]
  prices       OptionPrice[]
  orderOptions OrderCombinationOption[]
}

model OptionAllergen {
  optionId   String   @db.Uuid
  allergenId String   @db.Uuid
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, allergenId])
  @@index([allergenId])
}

model OptionDietaryTag {
  optionId     String     @db.Uuid
  dietaryTagId String     @db.Uuid
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)
  option       Option     @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, dietaryTagId])
  @@index([dietaryTagId])
}

model OptionGroup {
  id           String              @id @default(uuid()) @db.Uuid
  dishId       String              @db.Uuid
  name         String
  required     Boolean             @default(false)
  displayOrder Int                 @default(0)
  dish         Dish                @relation(fields: [dishId], references: [id], onDelete: Cascade)
  options      OptionGroupOption[]
  sizes        OptionGroupSize[]

  @@unique([dishId, name])
}

model OptionGroupOption {
  optionGroupId String                  @db.Uuid
  optionId      String                  @db.Uuid
  displayOrder  Int                     @default(0)
  optionGroup   OptionGroup             @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  option        Option                  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  sizePrices    OptionGroupOptionSize[]

  @@id([optionGroupId, optionId])
  @@index([optionId])
}

model PortionSize {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String                  @unique
  displayOrder Int                     @default(0)
  active       Boolean                 @default(true)
  optionPrices OptionGroupOptionSize[]
  groups       OptionGroupSize[]
  combinations OrderCombination[]
}

model OptionGroupSize {
  optionGroupId String                  @db.Uuid
  portionSizeId String                  @db.Uuid
  optionPrices  OptionGroupOptionSize[]
  optionGroup   OptionGroup             @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  portionSize   PortionSize             @relation(fields: [portionSizeId], references: [id], onDelete: Cascade)

  @@id([optionGroupId, portionSizeId])
  @@index([portionSizeId])
}

model OptionGroupOptionSize {
  optionGroupId String            @db.Uuid
  optionId      String            @db.Uuid
  portionSizeId String            @db.Uuid
  extraCharge   Decimal           @db.Decimal(10, 2)
  groupOption   OptionGroupOption @relation(fields: [optionGroupId, optionId], references: [optionGroupId, optionId], onDelete: Cascade)
  groupSize     OptionGroupSize   @relation(fields: [optionGroupId, portionSizeId], references: [optionGroupId, portionSizeId], onDelete: Cascade)
  option        Option            @relation(fields: [optionId], references: [id])
  portionSize   PortionSize       @relation(fields: [portionSizeId], references: [id], onDelete: Cascade)

  @@id([optionGroupId, optionId, portionSizeId])
  @@index([portionSizeId])
}

model Category {
  id                String                      @id @default(uuid()) @db.Uuid
  name              String                      @unique
  displayOrder      Int                         @default(0)
  active            Boolean                     @default(true)
  secret            Boolean                     @default(false)
  dishes            CategoryDish[]
  companyVisibility CompanyCategoryVisibility[]
}

model CategoryDish {
  categoryId   String   @db.Uuid
  dishId       String   @db.Uuid
  displayOrder Int      @default(0)
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dish         Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([categoryId, dishId])
  @@index([dishId])
}

model CompanyCategoryVisibility {
  companyId  String   @db.Uuid
  categoryId String   @db.Uuid
  visible    Boolean  @default(true)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, categoryId])
  @@index([categoryId])
}

model CompanyDishVisibility {
  companyId String  @db.Uuid
  dishId    String  @db.Uuid
  visible   Boolean @default(true)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dish      Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([companyId, dishId])
  @@index([dishId])
}

model PricingTier {
  id                     String                @id @default(uuid()) @db.Uuid
  name                   String                @unique
  isDefault              Boolean               @default(false)
  derivationType         PricingDerivationType @default(NONE)
  derivationSourceTierId String?               @db.Uuid
  derivationFactor       Decimal?              @db.Decimal(8, 4)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  companies              Company[]
  dishPrices             DishPrice[]
  optionPrices           OptionPrice[]
  derivationSource       PricingTier?          @relation("PricingTierDerivation", fields: [derivationSourceTierId], references: [id])
  derivedTiers           PricingTier[]         @relation("PricingTierDerivation")

  @@index([derivationSourceTierId])
}

model DishPrice {
  id            String          @id @default(uuid()) @db.Uuid
  dishId        String          @db.Uuid
  pricingTierId String          @db.Uuid
  price         Decimal         @db.Decimal(10, 2)
  source        PricingPriceSource @default(MANUAL)
  dish          Dish            @relation(fields: [dishId], references: [id], onDelete: Cascade)
  pricingTier   PricingTier     @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)

  @@unique([dishId, pricingTierId])
  @@index([pricingTierId])
}

model OptionPrice {
  id            String          @id @default(uuid()) @db.Uuid
  optionId      String          @db.Uuid
  pricingTierId String          @db.Uuid
  price         Decimal         @db.Decimal(10, 2)
  source        PricingPriceSource @default(MANUAL)
  option        Option          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  pricingTier   PricingTier     @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)

  @@unique([optionId, pricingTierId])
  @@index([pricingTierId])
}

model Order {
  id                      String              @id @default(uuid()) @db.Uuid
  orderNumber             String              @unique
  employeeId              String              @db.Uuid
  companyId               String              @db.Uuid
  deliveryDate            DateTime            @db.Date
  deliveryTime            String
  deliveryAddressId       String?             @db.Uuid
  deliveryAddressSnapshot Json
  packaging               String
  status                  OrderStatus         @default(DRAFT)
  subtotal                Decimal             @db.Decimal(10, 2)
  total                   Decimal             @db.Decimal(10, 2)
  placedAt                DateTime?
  confirmedAt             DateTime?
  deliveredAt             DateTime?
  kitchenStartedAt        DateTime?
  kitchenReadyAt          DateTime?
  plannedDispatchReadyAt  DateTime?
  plannedKitchenReadyAt   DateTime?
  kitchenForceCompletedAt DateTime?
  cancelledAt             DateTime?
  dropId                  String?             @db.Uuid
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  adjustments             InvoiceAdjustment[]
  invoiceOrder            InvoiceOrder?
  prepUnits               KitchenPrepUnit[]
  company                 Company             @relation(fields: [companyId], references: [id])
  deliveryAddress         CompanyAddress?     @relation("OrderDeliveryAddress", fields: [deliveryAddressId], references: [id])
  drop                    Drop?               @relation(fields: [dropId], references: [id])
  employee                Employee            @relation(fields: [employeeId], references: [id])
  lines                   OrderLine[]

  @@index([companyId, deliveryDate])
  @@index([status, deliveryDate])
  @@index([employeeId])
  @@index([dropId])
  @@index([deliveryAddressId])
}

model OrderLine {
  id               String             @id @default(uuid()) @db.Uuid
  orderId          String             @db.Uuid
  dishId           String?            @db.Uuid
  dishNameSnapshot String
  dishSkuSnapshot  String
  quantity         Int
  unitPrice        Decimal            @db.Decimal(10, 2)
  lineTotal        Decimal            @db.Decimal(10, 2)
  combinations     OrderCombination[]
  dish             Dish?              @relation(fields: [dishId], references: [id])
  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([dishId])
}

model OrderCombination {
  id                      String                   @id @default(uuid()) @db.Uuid
  orderLineId             String                   @db.Uuid
  quantity                Int
  portionSizeId           String?                  @db.Uuid
  portionSizeNameSnapshot String
  unitPrice               Decimal                  @db.Decimal(10, 2)
  totalPrice              Decimal                  @db.Decimal(10, 2)
  prepUnits               KitchenPrepUnit[]
  orderLine               OrderLine                @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  portionSize             PortionSize?             @relation(fields: [portionSizeId], references: [id])
  options                 OrderCombinationOption[]

  @@index([orderLineId])
  @@index([portionSizeId])
}

model OrderCombinationOption {
  id                 String           @id @default(uuid()) @db.Uuid
  combinationId      String           @db.Uuid
  optionId           String?          @db.Uuid
  optionNameSnapshot String
  price              Decimal          @db.Decimal(10, 2)
  combination        OrderCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  option             Option?          @relation(fields: [optionId], references: [id])

  @@index([combinationId])
  @@index([optionId])
}

model KitchenPrepUnit {
  id                 String            @id @default(uuid()) @db.Uuid
  orderId            String            @db.Uuid
  orderCombinationId String            @db.Uuid
  stationId          String            @db.Uuid
  status             KitchenPrepStatus @default(PENDING)
  startedAt          DateTime?
  completedAt        DateTime?
  orderCombination   OrderCombination  @relation(fields: [orderCombinationId], references: [id], onDelete: Cascade)
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station            Station           @relation(fields: [stationId], references: [id])

  @@index([orderId])
  @@index([stationId, status])
  @@index([orderCombinationId])
}

model Drop {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @db.Uuid
  addressId        String         @db.Uuid
  deliveryDate     DateTime       @db.Date
  deliveryTime     String
  driverId         String?        @db.Uuid
  status           DropStatus     @default(KITCHEN_READY)
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  deliveredOnTime  Boolean?
  deliveryNote     String?
  deliveryPhotoUrl String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  address          CompanyAddress @relation("DropAddress", fields: [addressId], references: [id])
  company          Company        @relation(fields: [companyId], references: [id])
  driver           User?          @relation("DropDriver", fields: [driverId], references: [id])
  orders           Order[]

  @@unique([companyId, addressId, deliveryDate, deliveryTime])
  @@index([companyId, deliveryDate, deliveryTime])
  @@index([addressId])
  @@index([driverId])
}

model Invoice {
  id              String              @id @default(uuid()) @db.Uuid
  invoiceNumber   String              @unique
  companyId       String              @db.Uuid
  status          InvoiceStatus       @default(OPEN)
  subtotal        Decimal             @db.Decimal(10, 2)
  adjustmentTotal Decimal             @default(0) @db.Decimal(10, 2)
  total           Decimal             @db.Decimal(10, 2)
  issuedAt        DateTime?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  company         Company             @relation(fields: [companyId], references: [id])
  adjustments     InvoiceAdjustment[]
  orders          InvoiceOrder[]

  @@index([companyId, status])
}

model InvoiceOrder {
  invoiceId String  @db.Uuid
  orderId   String  @unique @db.Uuid
  amount    Decimal @db.Decimal(10, 2)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order     Order   @relation(fields: [orderId], references: [id])

  @@id([invoiceId, orderId])
}

model InvoiceAdjustment {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid
  orderId   String   @db.Uuid
  amount    Decimal  @db.Decimal(10, 2)
  reason    String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([invoiceId])
  @@index([orderId])
}

model KitchenSetting {
  id                Int      @id @default(1)
  cutoffTime        String
  cutoffWorkingDays Int
  mondayEnabled     Boolean  @default(true)
  tuesdayEnabled    Boolean  @default(true)
  wednesdayEnabled  Boolean  @default(true)
  thursdayEnabled   Boolean  @default(true)
  fridayEnabled     Boolean  @default(true)
  saturdayEnabled   Boolean  @default(false)
  sundayEnabled     Boolean  @default(false)
  timezone          String   @default("UTC")
  updatedAt         DateTime @updatedAt
}

model KitchenHoliday {
  id   String   @id @default(uuid()) @db.Uuid
  date DateTime @unique @db.Date
  name String
}

model CompanyHoliday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  date      DateTime @db.Date
  name      String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
}

model DishAllergen {
  dishId     String   @db.Uuid
  allergenId String   @db.Uuid
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([dishId, allergenId])
  @@index([allergenId])
}

model DishDietaryTag {
  dishId       String     @db.Uuid
  dietaryTagId String     @db.Uuid
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)
  dish         Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@id([dishId, dietaryTagId])
  @@index([dietaryTagId])
}

enum Temperature {
  HOT
  COLD
}

enum PricingDerivationType {
  NONE
  COST_FACTOR
  TIER_PERCENTAGE
}

enum PricingPriceSource {
  MANUAL
  DERIVED
  OVERRIDE
}

enum OrderStatus {
  DRAFT
  PLACED
  CONFIRMED
  DELIVERED
  CANCELLED
  REJECTED
}

enum KitchenPrepStatus {
  PENDING
  STARTED
  DONE
}

enum DropStatus {
  KITCHEN_READY
  DISPATCH_READY
  OUT_FOR_DELIVERY
  DELIVERED
}

enum InvoiceStatus {
  OPEN
  PAID
}
